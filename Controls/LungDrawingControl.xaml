<UserControl x:Class="testWPF.Controls.LungDrawingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="850">

    <Border Background="{DynamicResource TertiaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Unified Toolbar ────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">

                    <!-- Mode: Draw -->
                    <RadioButton x:Name="DrawRadio"
                                 Content="✏️ Dessiner"
                                 IsChecked="True"
                                 Checked="DrawMode_Checked"
                                 Style="{DynamicResource {x:Type ToggleButton}}"
                                 Padding="10,6" Margin="0,0,4,0"
                                 FontSize="12" Cursor="Hand" />

                    <!-- Mode: Eraser -->
                    <RadioButton x:Name="EraseRadio"
                                 Content="🧹 Gomme"
                                 Checked="EraseMode_Checked"
                                 Style="{DynamicResource {x:Type ToggleButton}}"
                                 Padding="10,6" Margin="0,0,8,0"
                                 FontSize="12" Cursor="Hand" />

                    <!-- Separator -->
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="4,0,8,0" VerticalAlignment="Center" />

                    <!-- History Actions -->
                    <Button Content="↩ Annuler"
                            Click="UndoButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Margin="0,0,4,0"
                            FontSize="12" Cursor="Hand"
                            ToolTip="Annuler le dernier tracé" />

                    <Button Content="↪ Rétablir"
                            Click="RedoButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Margin="0,0,4,0"
                            FontSize="12" Cursor="Hand"
                            ToolTip="Rétablir le tracé" />

                    <Button Content="🗑 Tout effacer"
                            Click="ClearButton_Click"
                            Style="{StaticResource DangerButton}"
                            Padding="8,5" Margin="0,0,8,0"
                            FontSize="12" Cursor="Hand"
                            ToolTip="Effacer toutes les annotations" />

                    <!-- Separator -->
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="4,0,8,0" VerticalAlignment="Center" />

                    <!-- Pen Size -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Épaisseur:"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="PenSizeCombo"
                                  Width="65" FontSize="12"
                                  SelectionChanged="PenSizeCombo_SelectionChanged"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="1 px" />
                            <ComboBoxItem Content="2 px" />
                            <ComboBoxItem Content="3 px" IsSelected="True" />
                            <ComboBoxItem Content="5 px" />
                            <ComboBoxItem Content="8 px" />
                            <ComboBoxItem Content="12 px" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="4,0,8,0" VerticalAlignment="Center" />

                    <!-- Color Presets -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Couleur:"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Button Click="ColorButton_Click" Tag="#FFFF0000"
                                Width="24" Height="24" Margin="2,0" Cursor="Hand"
                                ToolTip="Rouge (Lésion)">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#FFFF0000" CornerRadius="4"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="ColorButton_Click" Tag="#FF0078FF"
                                Width="24" Height="24" Margin="2,0" Cursor="Hand"
                                ToolTip="Bleu">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#FF0078FF" CornerRadius="4"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="ColorButton_Click" Tag="#FF00C853"
                                Width="24" Height="24" Margin="2,0" Cursor="Hand"
                                ToolTip="Vert">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#FF00C853" CornerRadius="4"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="ColorButton_Click" Tag="#FFFFEB3B"
                                Width="24" Height="24" Margin="2,0" Cursor="Hand"
                                ToolTip="Jaune">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#FFFFEB3B" CornerRadius="4"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="ColorButton_Click" Tag="#FFFFFFFF"
                                Width="24" Height="24" Margin="2,0" Cursor="Hand"
                                ToolTip="Blanc">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#FFFFFFFF" CornerRadius="4"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="ColorButton_Click" Tag="#FF000000"
                                Width="24" Height="24" Margin="2,0" Cursor="Hand"
                                ToolTip="Noir">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#FF000000" CornerRadius="4"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </WrapPanel>
            </Border>

            <!-- ── Drawing Canvas Area ───────────────────────────────── -->
            <Border Grid.Row="1"
                    Background="#FF1F2228"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">

                <Grid x:Name="DrawingArea">
                    <!-- Original lung image -->
                    <Image x:Name="LungImage"
                           Source="/Assets/Lung_Labeled_Diagram2.jpg"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- Drawing overlay — matched to image size -->
                    <InkCanvas x:Name="LungInkCanvas"
                               Background="Transparent"
                               EditingMode="Ink"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               StrokeCollected="LungInkCanvas_StrokeCollected"/>
                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>