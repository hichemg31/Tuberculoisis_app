<Window x:Class="testWPF.Views.LungAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:testWPF.Controls"
        Title="Schéma Pulmonaire — Annotation"
        Width="920" Height="740"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindowStyle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🫁" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Schéma Pulmonaire" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PatientInfoText"
                               Text="Cas N° 1 — Patient"
                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="34,4,0,0" />
                </StackPanel>

                <Button Content="✕"
                        Style="{StaticResource IconButton}"
                        Click="CancelButton_Click"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="8,4" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- ── Drawing Control (Spacious Center Area) ────────────────── -->
        <ctrl:LungDrawingControl x:Name="DrawingControl"
                                 Grid.Row="1"
                                 Margin="0,0,0,16" />

        <!-- ── Footer Actions ────────────────────────────────────────── -->
        <Border Grid.Row="2" Padding="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="💡 Dessinez les lésions ou zones affectées directement sur le schéma."
                           FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click"
                            Padding="16,10"
                            Margin="0,0,10,0" />

                    <Button Content="✓ Enregistrer l'annotation"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveButton_Click"
                            Padding="20,10" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
